// Hotel Management System data model
// Multi-tenant: every operational table carries an indexed hotelId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomCategory {
  standard
  deluxe
  suite
  custom
}

enum RoomStatus {
  available
  occupied
  dirty
  cleaning
}

enum EmployeeRole {
  receptionist
  manager
}

enum BookingStatus {
  active
  checked_out
}

enum HousekeepingStatus {
  dirty
  in_progress
  completed
}

enum StaffStatus {
  available
  assigned
}

/// One row per hotel (tenant).
model Hotel {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  contactNumber  String   @map("contact_number")
  email          String
  address        String
  totalRooms     Int      @map("total_rooms")
  employeesCount Int      @map("employees_count")
  setupCompleted Boolean  @default(false) @map("setup_completed")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  roomTypes          RoomType[]
  rooms              Room[]
  employees          Employee[]
  customers          Customer[]
  bookings           Booking[]
  housekeeping       Housekeeping[]
  revenueLogs        RevenueLog[]
  dailyBookingCounts DailyBookingCount[]
  staff              Staff[]

  @@map("hotels")
}

model RoomType {
  id        String       @id @default(uuid()) @db.Uuid
  hotelId   String       @map("hotel_id") @db.Uuid
  category  RoomCategory
  name      String
  count     Int
  basePrice Decimal      @map("base_price") @db.Decimal(10, 2)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  hotel Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@index([hotelId])
  @@map("room_types")
}

model Room {
  id         String     @id @default(uuid()) @db.Uuid
  hotelId    String     @map("hotel_id") @db.Uuid
  roomNumber String     @map("room_number")
  roomTypeId String     @map("room_type_id") @db.Uuid
  status     RoomStatus @default(available)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  hotel         Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType      RoomType       @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  bookings      Booking[]
  housekeeping  Housekeeping[]
  assignedStaff Staff[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, status])
  @@map("rooms")
}

/// Login identities (receptionist / manager).
model Employee {
  id           String       @id @default(uuid()) @db.Uuid
  hotelId      String       @map("hotel_id") @db.Uuid
  username     String
  passwordHash String       @map("password_hash")
  role         EmployeeRole
  name         String
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, username])
  @@map("employees")
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  hotelId        String   @map("hotel_id") @db.Uuid
  name           String
  phone          String
  idProof        String?  @map("id_proof")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  isSynthetic    Boolean  @default(false) @map("is_synthetic")
  datasetVersion String?  @map("dataset_version")

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([hotelId])
  @@index([hotelId, phone])
  @@map("customers")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  hotelId        String        @map("hotel_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  roomId         String        @map("room_id") @db.Uuid
  checkinTime    DateTime      @map("checkin_time")
  checkoutTime   DateTime?     @map("checkout_time")
  initialPayment Decimal       @map("initial_payment") @db.Decimal(10, 2)
  totalAmount    Decimal?      @map("total_amount") @db.Decimal(10, 2)
  status         BookingStatus @default(active)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  isSynthetic    Boolean       @default(false) @map("is_synthetic")
  datasetVersion String?       @map("dataset_version")

  hotel       Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  revenueLogs RevenueLog[]

  @@index([hotelId])
  @@index([hotelId, status])
  @@index([hotelId, checkinTime])
  @@index([roomId])
  @@index([customerId])
  @@map("bookings")
}

model Housekeeping {
  id                String             @id @default(uuid()) @db.Uuid
  hotelId           String             @map("hotel_id") @db.Uuid
  roomId            String             @map("room_id") @db.Uuid
  assignedStaff     String?            @map("assigned_staff")
  status            HousekeepingStatus @default(dirty)
  markedDirtyAt     DateTime?          @map("marked_dirty_at")
  cleaningStartedAt DateTime?          @map("cleaning_started_at")
  completedAt       DateTime?          @map("completed_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  staffId           String?            @map("staff_id") @db.Uuid

  hotel Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@index([hotelId, status])
  @@index([roomId])
  @@map("housekeeping")
}

/// Append-only revenue ledger.
model RevenueLog {
  id             String   @id @default(uuid()) @db.Uuid
  hotelId        String   @map("hotel_id") @db.Uuid
  bookingId      String   @map("booking_id") @db.Uuid
  amount         Decimal  @db.Decimal(10, 2)
  date           DateTime @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  isSynthetic    Boolean  @default(false) @map("is_synthetic")
  datasetVersion String?  @map("dataset_version")

  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([hotelId, date])
  @@map("revenue_log")
}

/// One row per (hotel, date) with that day's booking count (AI input).
model DailyBookingCount {
  id             String   @id @default(uuid()) @db.Uuid
  hotelId        String   @map("hotel_id") @db.Uuid
  date           DateTime @db.Date
  count          Int      @default(0)
  isSpikePeriod  Boolean  @default(false) @map("is_spike_period")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  isSynthetic    Boolean  @default(false) @map("is_synthetic")
  datasetVersion String?  @map("dataset_version")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, date])
  @@map("daily_booking_counts")
}

model Staff {
  id             String      @id @default(uuid()) @db.Uuid
  hotelId        String      @map("hotel_id") @db.Uuid
  name           String
  status         StaffStatus @default(available)
  assignedRoomId String?     @map("assigned_room_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  hotel        Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assignedRoom Room?          @relation(fields: [assignedRoomId], references: [id], onDelete: SetNull)
  housekeeping Housekeeping[]

  @@index([hotelId])
  @@index([hotelId, status])
  @@map("staff")
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt(sort: Desc)])
  @@map("login_attempts")
}